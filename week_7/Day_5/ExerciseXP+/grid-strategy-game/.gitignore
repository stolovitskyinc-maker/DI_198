# Dependency directories (never commit these, they are generated by npm install)
node_modules/
jspm_packages/

# Debug logs generated by npm errors
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating System specific files
.DS_Store
Thumbs.db

# Environment variables and credentials (in case you add a .env file later)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Optional VS Code configurations you might not want to share with others
.vscode/
*.suo
*.ntvs*
*.njsproj
